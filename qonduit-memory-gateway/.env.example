# Core gateway
LLAMA_BASE=http://127.0.0.1:8080
GATEWAY_DATA_DIR=/app/data
DEFAULT_CONTEXT_SIZE=65536
DEFAULT_MODE=chat
DEFAULT_PROJECT_ID=default
PROJECT_DEFAULT_MODE=chat

# Alias + endpoint binding (JSON strings)
MODEL_ALIAS_CONFIG={}
PROJECT_DEFAULT_MODE_MAP={}
PROJECT_HOST_BINDINGS={}
ENDPOINT_BINDINGS={}
PROJECTS_ROOT=/opt/projects
PROJECT_ALIAS_TARGET_MODEL=gpt-oss:20b
PROJECT_ALIAS_CACHE_TTL_SECONDS=60
INGESTION_POLL_SECONDS=2
INGESTION_STALL_TIMEOUT_SECONDS=600
INGESTION_FILE_TIMEOUT_SECONDS=120

# Retrieval / embeddings
RAG_ENABLED=true
RAG_TOP_K=4
RAG_PROJECT_FLAGS={}
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
EMBEDDING_BASE=http://127.0.0.1:8082
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_VECTOR_SIZE=384

# Host webhook receiver (Phase 3)
GITHUB_WEBHOOK_SECRET=
GATEWAY_ENQUEUE_URL=http://127.0.0.1:8090/v1/ingestion/enqueue
GITHUB_REPO_PATH_OVERRIDES={}
GITHUB_PROJECT_ID_OVERRIDES={}
